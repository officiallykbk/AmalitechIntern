# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# 1. Use a faster npm registry
RUN npm config set registry https://registry.npmmirror.com

# 2. Copy package files first
COPY package*.json ./
COPY prisma ./prisma/

# 3. Install all dependencies including devDependencies
RUN npm ci

# 4. Set a dummy DATABASE_URL for prisma generate
ENV DATABASE_URL="postgresql://dockerUser:2016@db:5432/dockerApp"

# 5. Generate Prisma client
RUN npx prisma generate

# 6. Build the application
COPY . .
RUN npm run build

# Stage 2: Production
FROM node:20-alpine

WORKDIR /app

# 7. Copy package files
COPY package*.json ./

# 8. Install only production deps
RUN npm ci --omit=dev

# 9. Copy built files and Prisma client
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules/.prisma /app/node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma /app/node_modules/@prisma
COPY --from=builder /app/prisma ./prisma

# 10. Expose and run
EXPOSE 3000

# 11. Run migrations and start the server
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/server.js"]